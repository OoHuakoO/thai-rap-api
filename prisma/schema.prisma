generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  ASSESSOR
  MENTOR
  ENTREPRENEUR
  JUDGE
  // ผู้ใช้ทั่วไป — reads only the store fields the project marks disclosable.
  VIEWER
}

// The three categories the brief specifies for the announcement menu:
// GENERAL = ประชาสัมพันธ์ทั่วไป, EVENT = กิจกรรม, ALERT = การแจ้งเตือน
enum NewsType {
  GENERAL
  EVENT
  ALERT
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum StoreStatus {
  REGISTERED
  T0_COMPLETED
  CAMP_COMPLETED
  T1_COMPLETED
  PITCHING_COMPLETED
  SELECTED
  CONDITIONAL_SELECTED
  WAITING_LIST
  NOT_SELECTED
  FIELD_AUDITED
  IDP_CREATED
  COMPLETED
}

enum Round {
  T0
  T1
  T2
  T3
}

enum AssessmentStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  APPROVED
}

enum ScoreStatus {
  PENDING
  SCORED
  FLAGGED
}

enum RedFlagType {
  FOOD_SAFETY
  FINANCIAL
  OPERATION
  MARKET
  LEGAL
  OWNER_READINESS
  EVIDENCE
  GROWTH
}

enum Severity {
  WARNING
  CRITICAL
}

// The two judging rounds in the programme's own paper forms:
// PITCH_DECK   = แบบประเมิน Pitch Deck เพื่อคัดเลือกเข้า Incubation (10 หัวข้อ)
// ACCELERATION = แบบประเมินคัดเลือก Incubation สู่ Acceleration (หมวด A + B)
// Both are scored out of 100 but share no criterion — the round decides which
// set of PitchingCriterion rows a form carries.
enum PitchingRound {
  PITCH_DECK
  ACCELERATION
}

enum PitchingStatus {
  DRAFT
  SUBMITTED
}

// ความเห็นสรุปของกรรมการ. MINIMUM_NOT_MET exists on the ACCELERATION form only
// (ส่วนที่ 6) — the PITCH_DECK form has no minimum condition to fail.
enum PitchingRecommendation {
  SELECTED
  WAITING_LIST
  MINIMUM_NOT_MET
  NOT_SELECTED
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  password  String
  role      Role
  status    UserStatus @default(PENDING)
  lastLogin DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  refreshToken     RefreshToken?
  passwordResetOtp PasswordResetOtp?
  assessments      Assessment[]
  assignedStores   Store[]           @relation("AssignedAssessor")
  ownedStores      Store[]           @relation("StoreOwner")
  authoredNews     News[]            @relation("NewsAuthor")
  authoredActivity Activity[]        @relation("ActivityAuthor")
  pitchings        Pitching[]        @relation("PitchingJudge")
}

// ประชาสัมพันธ์ — the announcements the dashboard activity feed renders.
// Created by ADMIN/SUPER_ADMIN; every staff role reads.
model News {
  id          String   @id @default(cuid())
  type        NewsType
  title       String
  description String   @db.Text
  urgent      Boolean  @default(false)
  publishedAt DateTime @default(now())
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author User @relation("NewsAuthor", fields: [authorId], references: [id])

  @@index([publishedAt])
}

// ประมวลภาพกิจกรรม — the photo album of a programme activity (workshop, camp,
// site visit). Written by ADMIN/SUPER_ADMIN; every signed-in role reads it.
// There is no draft state: an album exists once an admin saves it.
model Activity {
  id           String   @id @default(cuid())
  title        String
  description  String   @db.Text
  // หมายเหตุ — internal remarks about the activity, optional by design.
  note         String?  @db.Text
  activityDate DateTime
  location     String?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdBy User            @relation("ActivityAuthor", fields: [createdById], references: [id])
  photos    ActivityPhoto[]

  @@index([activityDate])
}

model ActivityPhoto {
  id         String   @id @default(cuid())
  activityId String
  url        String
  sortOrder  Int      @default(0)
  uploadedAt DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId, sortOrder])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @unique
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One live OTP per user — requesting a new code replaces the previous row, so an
// old code can never be redeemed after the user asks for another one.
model PasswordResetOtp {
  id         String    @id @default(cuid())
  userId     String    @unique
  otpHash    String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Store ────────────────────────────────────────────────────────────────────

model Store {
  id            String      @id @default(cuid())
  // Project-wide identifier printed on every offline form and Excel export
  // (RAP69-001…). It is how a spreadsheet row is matched back to a row here —
  // the cuid id exists nowhere outside this database.
  code          String      @unique
  name          String
  // Nullable because the onboarding spreadsheet arrives with these blank for
  // most stores; the create form still requires them for a store keyed in by hand.
  province      String?
  storeType     String?
  ownerName     String?
  phone         String?
  email         String?
  address       String?     @db.Text
  socialLinks   Json        @default("{}")
  avgRevenueMin Float?
  avgRevenueMax Float?
  mainProblems  Json        @default("[]")
  goals         Json        @default("[]")
  menuPhotos    Json        @default("[]")
  coverUrl      String?
  storePhotos   Json        @default("[]")
  status        StoreStatus @default(REGISTERED)
  ownerId       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  owner         User?           @relation("StoreOwner", fields: [ownerId], references: [id])
  assessments   Assessment[]
  documents     StoreDocument[]
  assignedUsers User[]          @relation("AssignedAssessor")
  pitchings     Pitching[]

  // province leads because it is the selective one and is filtered on its own
  // by the province-cohort aggregate in sumRawScoreByQuestion; status extends
  // the same index for the /stores list, which filters on both together.
  @@index([province, status])
}

model StoreDocument {
  id         String   @id @default(cuid())
  storeId    String
  filename   String
  fileType   String
  fileSize   Int
  url        String
  uploadedAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id])
}

// ─── Lookup ───────────────────────────────────────────────────────────────────

model Province {
  id     Int    @id @default(autoincrement())
  nameTh String @unique
}

model StoreType {
  id     Int    @id @default(autoincrement())
  nameTh String @unique
}

// ─── Assessment ───────────────────────────────────────────────────────────────

model Dimension {
  id            Int        @id
  name          String
  nameEn        String
  weight        Int
  questionCount Int
  questions     Question[]
}

model Question {
  id           Int       @id
  dimensionId  Int
  questionNo   Int
  questionText String    @db.Text
  maxScore     Int       @default(4)
  dimension    Dimension @relation(fields: [dimensionId], references: [id])
  scores       Score[]
}

model Assessment {
  id          String           @id @default(cuid())
  storeId     String
  round       Round
  assessorId  String
  status      AssessmentStatus @default(DRAFT)
  totalScore  Float?
  notes       String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  submittedAt DateTime?

  store    Store     @relation(fields: [storeId], references: [id])
  assessor User      @relation(fields: [assessorId], references: [id])
  scores   Score[]
  redFlags RedFlag[]

  @@unique([storeId, round])
  // Ranking reads one cohort per call: every finished assessment in a round.
  // AssessmentRepository.findSubmittedForRanking filters on exactly this pair,
  // and sumRawScoreByQuestion joins Score through the same predicate.
  @@index([round, status])
}

model Score {
  id           String      @id @default(cuid())
  assessmentId String
  questionId   Int
  rawScore     Int?
  displayScore Int?
  note         String?     @db.Text
  suggestion   String?     @db.Text
  status       ScoreStatus @default(PENDING)

  assessment Assessment @relation(fields: [assessmentId], references: [id])
  question   Question   @relation(fields: [questionId], references: [id])
  evidences  Evidence[]

  @@unique([assessmentId, questionId])
}

model Evidence {
  id         String   @id @default(cuid())
  scoreId    String
  filename   String
  fileType   String
  fileSize   Int
  url        String
  uploadedAt DateTime @default(now())

  score Score @relation(fields: [scoreId], references: [id])
}

model RedFlag {
  id               String      @id @default(cuid())
  assessmentId     String
  type             RedFlagType
  severity         Severity
  triggerQuestions Json        @default("[]")
  recommendation   String?     @db.Text
  resolved         Boolean     @default(false)

  assessment Assessment @relation(fields: [assessmentId], references: [id])
}

// ─── Pitching ─────────────────────────────────────────────────────────────────

// The scoring rows of the two paper forms, seeded like Dimension/Question.
// Ids are fixed and prefixed by round (1xx = PITCH_DECK, 2xx = ACCELERATION) so
// a stored PitchingScore keeps pointing at the same criterion forever — the
// same reason Question.id is pinned. maxScore differs per row (5/10/15 on the
// pitch deck form, 2–10 on the acceleration one); Σ maxScore per round is 100.
model PitchingCriterion {
  id        Int           @id
  round     PitchingRound
  // "1".."10" on the pitch deck form, "1.1".."5.4" on the acceleration one —
  // printed on the paper form, so it is what a judge cross-checks against.
  code      String
  // หมวด A / หมวด B on the acceleration form; null on the pitch deck form,
  // which has no sections.
  section   String?
  title     String
  guideline String        @db.Text
  maxScore  Int
  sortOrder Int

  scores PitchingScore[]

  @@unique([round, code])
  @@index([round, sortOrder])
}

// One judge's completed form for one store in one round. Submitting it changes
// nothing outside this table — Store.status is deliberately never written from
// here, because selection is a committee decision taken on the averaged scores,
// not a consequence of any single judge saving a form.
model Pitching {
  id         String         @id @default(cuid())
  storeId    String
  round      PitchingRound
  judgeId    String
  status     PitchingStatus @default(DRAFT)
  // Frozen Σ of the criterion scores at submit; null while still a draft.
  totalScore Float?

  // ── ACCELERATION only ──────────────────────────────────────────────────────
  // ผลิตภัณฑ์/เมนูต้นแบบ on the form header.
  prototypeProduct String?
  // เงื่อนไขขั้นต่ำ: Score Card 8 มิติ (x/40) and เข้าร่วม/ส่งงาน (%). Kept as the
  // judge's own reading rather than derived from Assessment, because the paper
  // form is filled from the evidence file in the room and must still reproduce
  // what was decided there. Pass/fail is computed, never stored.
  scoreCardTotal   Int?
  participationPct Float?
  // หลักฐานที่ตรวจสอบ — the checklist keys the judge ticked.
  evidenceChecked  Json    @default("[]")

  // ความเห็นของคณะกรรมการ, keyed by the prompts of that round's form
  // (PITCHING_COMMENT_KEYS). A map rather than columns because the two rounds
  // ask different questions and neither set is scored.
  comments             Json                    @default("{}")
  recommendation       PitchingRecommendation?
  recommendationReason String?                 @db.Text
  // ☐ ข้าพเจ้าไม่มีส่วนได้เสียกับกิจการที่ประเมิน (acceleration form).
  noConflictOfInterest Boolean                 @default(false)
  // วันที่ประเมิน as written on the form, which is not the row's createdAt.
  evaluatedAt          DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  submittedAt DateTime?

  store  Store           @relation(fields: [storeId], references: [id])
  judge  User            @relation("PitchingJudge", fields: [judgeId], references: [id])
  scores PitchingScore[]

  // One form per judge per store per round — a judge revises their own row
  // rather than filing a second one.
  @@unique([storeId, round, judgeId])
  // The report reads one cohort per call: every submitted form in a round.
  @@index([round, status])
}

model PitchingScore {
  id          String  @id @default(cuid())
  pitchingId  String
  criterionId Int
  score       Int?
  // หลักฐาน/ข้อสังเกต per row on the acceleration form; free notes on the other.
  note        String? @db.Text

  pitching  Pitching          @relation(fields: [pitchingId], references: [id], onDelete: Cascade)
  criterion PitchingCriterion @relation(fields: [criterionId], references: [id])

  @@unique([pitchingId, criterionId])
}

// A report is not stored: the list on the dashboard and the /reports page is
// derived from the submitted assessments a caller may read, and every download
// re-renders the file from those scores. Nothing here to persist.
