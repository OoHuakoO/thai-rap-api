# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=api
API_VERSION=1

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://root:root@localhost:3306/thai_rap"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Minimum 32 characters — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_access_secret_minimum_32_characters
JWT_REFRESH_SECRET=change_me_refresh_secret_minimum_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Refresh cookie SameSite: use "lax" (default) if frontend/api are different domains,
# "strict" only if same site, "none" (requires https) for cross-site deployments
COOKIE_SAME_SITE=lax

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3001

# ─── Mail (password reset OTP) ────────────────────────────────────────────────
# Leave SMTP_PROVIDER and SMTP_HOST both empty in development — the OTP is
# written to the server log instead of being emailed, so the reset flow works
# without a mail server.
#
# SMTP_PROVIDER fills in host/port/secure for you:
#   gmail      → smtp.gmail.com:587
#   outlook    → smtp-mail.outlook.com:587   (personal @outlook.com / @hotmail.com)
#   office365  → smtp.office365.com:587      (Microsoft 365 work/school account)
#
# SMTP_PASSWORD is never the account password:
#   Gmail      → turn on 2-Step Verification, then create an App Password
#                (myaccount.google.com/apppasswords) and paste the 16 chars here.
#   Microsoft  → basic-auth SMTP is disabled on most tenants and on personal
#                accounts. A work/school tenant must have SMTP AUTH enabled for
#                the mailbox by an admin; otherwise use a provider that still
#                accepts a password (Gmail, SendGrid, Resend, Brevo).
SMTP_PROVIDER=
# Only needed for a provider not in the list above — overrides the preset.
SMTP_HOST=
SMTP_PORT=
# true only for implicit TLS on port 465; STARTTLS on 587 stays false
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Leave empty to send as SMTP_USER. Gmail and Outlook rewrite or reject any
# other From address, so only set this to an alias the mailbox may send as.
MAIL_FROM=
PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_OTP_MAX_ATTEMPTS=5

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# TTL in milliseconds (default: 60000 = 1 minute)
THROTTLE_TTL=60000
# Max requests per TTL window
THROTTLE_LIMIT=100
